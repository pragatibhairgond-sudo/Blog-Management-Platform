async function fetchBlogs() {
  try {
    const res = await fetch('/api/blogs');
    if (!res.ok) throw new Error("Backend offline");
    allBlogs = await res.json();
  } catch (err) {
    console.warn("Backend API not connected. Displaying fallback articles:", err);
    
    // Fallback sample data so posts appear on GitHub Pages
    allBlogs = [
      {
        id: 1,
        title: "HTML Basics & Modern Semantic Tags",
        author: "Tim Berners-Lee",
        description: "HTML is the backbone of the web. Learn about modern semantic elements, accessibility, and structured document markup.",
        date: "Aug 4, 2026"
      },
      {
        id: 2,
        title: "Mastering CSS Flexbox & Modern Grid",
        author: "Håkon Wium Lie",
        description: "Explore how to build modern responsive web page layouts effortlessly using flexible box containers and 2D grid systems.",
        date: "Aug 5, 2026"
      },
      {
        id: 3,
        title: "Async JavaScript & The Fetch API",
        author: "Brendan Eich",
        description: "Understand Promises, async/await syntax, and how to seamlessly fetch data from RESTful APIs in modern web applications.",
        date: "Aug 6, 2026"
      }
    ];
  }
  renderBlogs(allBlogs);
}